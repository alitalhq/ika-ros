<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ika_base</name>
  <version>0.1.0</version>
  <description>
    Diferansiyel sürüş tabanı: /cmd_vel'i enkoder geri beslemeli PI hız kontrolüyle
    H-bridge motorlara uygular, teker odometrisi ve joint_states yayınlar.
  </description>
  <maintainer email="alitlhq@icloud.com">Ali Talha</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ika_hal</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
