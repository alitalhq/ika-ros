<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ika_hal</name>
  <version>0.1.0</version>
  <description>
    Gemstone GPIO (libgpiod v1/v2) ve sysfs PWM için ortak donanım katmanı;
    donanımsız geliştirme için mock arka uç içerir.
  </description>
  <maintainer email="alitlhq@icloud.com">Ali Talha</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-libgpiod</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
