<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ika_imu</name>
  <version>0.1.0</version>
  <description>
    Gemstone O1 dahili ICM-20948 IMU sürücüsü (SPI). Açılışta jiroskop sapmasını
    kalibre eder ve imu/data_raw yayınlar. icm20948.c/.h: T3 Foundation, Apache-2.0.
  </description>
  <maintainer email="alitlhq@icloud.com">Ali Talha</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
